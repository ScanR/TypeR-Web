#!/bin/sh
# Installed TypeR Studio apps follow the site through web/desktop-update.json, signed. They take
# an update only when every file online is the one it names, so a push of main without a fresh
# one leaves them all on their version. Its notes, web/whats-new.json, list the feat(web) and
# fix(web) commits that the app shows at start. This refuses a push without both up to date;
# when main is the branch in hand, it writes them and commits them first, in one commit, and
# the push only needs to be run again.
# Enabled per clone with: git config core.hooksPath .githooks

root=$(git rev-parse --show-toplevel) || exit 1
zero=0000000000000000000000000000000000000000
message="chore(web): sign the update the desktop apps follow"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue
  node "$root/desktop/scripts/check-web-update.js" "$local_sha" && continue

  # The notes first, in a commit of their own, then the update signed on that commit, put in
  # the same commit: the files it names stay the same
  if [ "$local_sha" = "$(git rev-parse HEAD)" ] && node "$root/desktop/scripts/whats-new.js" HEAD &&
    { git show HEAD:web/whats-new.json 2>/dev/null | cmp -s - "$root/web/whats-new.json" && amend= ||
      { git add -- "$root/web/whats-new.json" && git commit --quiet --no-verify --only -m "$message" -- "$root/web/whats-new.json" && amend=--amend; }; } &&
    node "$root/desktop/scripts/publish-web.js" HEAD &&
    git commit --quiet --no-verify $amend --only -m "$message" -- "$root/web/desktop-update.json"; then
    echo "What's new and the signed update committed on top ($(git rev-parse --short HEAD)). Run the push again." >&2
  else
    echo "Write the notes and sign that commit, commit both files alone, then push again:" >&2
    echo "  node desktop/scripts/whats-new.js && git add web/whats-new.json && git commit --only -m '$message' -- web/whats-new.json" >&2
    echo "  node desktop/scripts/publish-web.js && git commit --amend --no-edit --only -- web/desktop-update.json" >&2
  fi
  status=1
done

exit $status
